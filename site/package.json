{
  "name": "ai-software-factory-mastery-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:generate": "node --experimental-strip-types scripts/generate-content.mjs",
    "content:generate:compat": "env -u NEXT_PUBLIC_SITE_URL node --experimental-strip-types scripts/generate-content.mjs",
    "editorial:check": "node scripts/check-editorial-integrity.mjs",
    "infographics:generate": "node scripts/generate-infographics.mjs",
    "infographics:list": "node scripts/list-infographic-slots.mjs",
    "links": "node --experimental-strip-types scripts/check-links.mjs",
    "microfrontends:sync": "node --experimental-strip-types scripts/sync-microfrontends-snapshot.mjs",
    "microfrontends:check": "node --experimental-strip-types scripts/sync-microfrontends-snapshot.mjs --check",
    "microfrontends:port": "VC_MICROFRONTENDS_CONFIG_FILE_NAME=config/microfrontends.generated.json microfrontends port",
    "microfrontends:proxy": "VC_MICROFRONTENDS_CONFIG_FILE_NAME=config/microfrontends.generated.json microfrontends proxy --local-apps fdlc ai-software-factory-mastery",
    "predev": "npm run content:generate",
    "dev": "GUIDE_STANDALONE_VINEXT=1 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "predev:next": "npm run content:generate",
    "dev:next": "GUIDE_NATIVE_LOCAL=1 next dev --webpack",
    "prebuild": "npm run content:generate",
    "build": "GUIDE_STANDALONE_VINEXT=1 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "vercel-build": "npm run content:generate && GUIDE_VERCEL_BUILD=1 next build --webpack && node scripts/check-built-css.mjs",
    "start": "GUIDE_STANDALONE_VINEXT=1 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "pretest": "npm run content:generate:compat",
    "test": "env -u NEXT_PUBLIC_SITE_URL node --experimental-strip-types --test \"tests/**/*.test.mjs\"",
    "test:next": "node scripts/run-native-next-test.mjs",
    "test:next-runtime": "node scripts/check-next-runtime.mjs",
    "links:external": "node scripts/check-external-links.mjs",
    "a11y": "node scripts/check-a11y.mjs",
    "prelint": "npm run content:generate",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel"
  },
  "dependencies": {
    "@vercel/microfrontends": "2.4.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.17.2",
    "next": "16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "^1.54.2",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright": "1.62.1",
    "react-server-dom-webpack": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
